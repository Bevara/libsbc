{
    "name": "libsbc",
    "version": "1.0.1",
    "description": "SBC (Bluetooth subband codec) decoder",
    "filters": [
        "sbcdec"
    ],
    "help": "This filter decodes raw SBC audio, the low-complexity subband codec of Bluetooth A2DP, using libsbc from BlueZ.",
    "support": [
        "audio"
    ],
    "sources": "https://bevara.ddns.net/sources/libsbc.accessor",
    "filter_source": {
        "sbcdec": "dec_sbc.c"
    },
    "extension": {
        "sbc": "audio",
        "msbc": "audio"
    },
    "using": [
        "mm_solver_minimal_1.0.1",
        "mm_solver_1.0.1",
        "mm_solver_1.0.2",
        "mm_solver_1.0.3",
        "mm_solver_1.0.4",
        "mm_solver_1.0.5"
    ],
    "patents": {
        "status": "under-review",
        "note": "SBC: Bluetooth A2DP codec",
        "checked": "2026-10-16"
    }
}
